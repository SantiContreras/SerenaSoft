<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ticket_venta" pageWidth="226" pageHeight="700" columnWidth="206" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" whenNoDataType="NoPages"><parameter name="VENTA_ID" class="java.lang.Long"/><parameter name="COMERCIO_NOMBRE" class="java.lang.String"/><parameter name="COMERCIO_RAZON" class="java.lang.String"/><parameter name="COMERCIO_CUIT" class="java.lang.String"/><parameter name="COMERCIO_DIRECCION" class="java.lang.String"/><parameter name="COMERCIO_TELEFONO" class="java.lang.String"/><parameter name="MENSAJE_FINAL" class="java.lang.String"/><queryString><![CDATA[SELECT v.numero_venta,v.fecha,v.total,v.subtotal AS bruto,v.descuento_total,u.nombre_completo AS cajero,
COALESCE(NULLIF(TRIM(c.razon_social),''),NULLIF(TRIM(CONCAT_WS(' ',NULLIF(TRIM(c.nombre),''),NULLIF(TRIM(c.apellido),''))),''),'Consumidor Final') AS cliente,
d.descripcion_producto,d.cantidad,d.precio_unitario,d.subtotal AS importe,
COALESCE((SELECT GROUP_CONCAT(mp.nombre SEPARATOR ', ') FROM venta_pago vp JOIN medio_pago mp ON mp.id_medio_pago=vp.id_medio_pago WHERE vp.id_venta=v.id_venta),'Sin especificar') AS medio_pago,
COALESCE((SELECT SUM(vp.importe_recibido) FROM venta_pago vp WHERE vp.id_venta=v.id_venta),v.total) AS recibido,
COALESCE((SELECT SUM(vp.cambio) FROM venta_pago vp WHERE vp.id_venta=v.id_venta),0) AS cambio
FROM venta v JOIN venta_detalle d ON d.id_venta=v.id_venta LEFT JOIN cliente c ON c.id_cliente=v.id_cliente JOIN usuario u ON u.id_usuario=v.id_usuario WHERE v.id_venta=$P{VENTA_ID} ORDER BY d.id_detalle]]></queryString><field name="numero_venta" class="java.lang.Long"/><field name="fecha" class="java.sql.Timestamp"/><field name="total" class="java.math.BigDecimal"/><field name="bruto" class="java.math.BigDecimal"/><field name="descuento_total" class="java.math.BigDecimal"/><field name="cajero" class="java.lang.String"/><field name="cliente" class="java.lang.String"/><field name="descripcion_producto" class="java.lang.String"/><field name="cantidad" class="java.math.BigDecimal"/><field name="precio_unitario" class="java.math.BigDecimal"/><field name="importe" class="java.math.BigDecimal"/><field name="medio_pago" class="java.lang.String"/><field name="recibido" class="java.math.BigDecimal"/><field name="cambio" class="java.math.BigDecimal"/><title><band height="200"><textField isStretchWithOverflow="false"><reportElement x="0" y="0" width="206" height="22"/><textElement textAlignment="Center"><font fontName="SansSerif" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMERCIO_NOMBRE}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="24" width="206" height="12"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="false"/></textElement><textFieldExpression><![CDATA["Razón social: " + $P{COMERCIO_RAZON}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="37" width="206" height="12"/><textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["CUIT: " + $P{COMERCIO_CUIT}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="50" width="206" height="12"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="false"/></textElement><textFieldExpression><![CDATA[$P{COMERCIO_DIRECCION}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="63" width="206" height="12"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="false"/></textElement><textFieldExpression><![CDATA["WhatsApp: " + $P{COMERCIO_TELEFONO}]]></textFieldExpression></textField><line><reportElement x="0" y="79" width="206" height="1"/></line><staticText><reportElement x="0" y="85" width="206" height="14"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10" isBold="true"/></textElement><text><![CDATA[COMPROBANTE DE VENTA]]></text></staticText><staticText><reportElement x="0" y="100" width="206" height="12"/><textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="false"/></textElement><text><![CDATA[TICKET NO FISCAL]]></text></staticText><textField isStretchWithOverflow="false"><reportElement x="0" y="115" width="206" height="14"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Venta N.º " + String.format("%08d",$F{numero_venta})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="133" width="206" height="12"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="147" width="206" height="12"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Cajero: " + $F{cajero}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="161" width="206" height="13"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Cliente: " + $F{cliente}]]></textFieldExpression></textField><line><reportElement x="0" y="179" width="206" height="1"/></line><staticText><reportElement x="0" y="184" width="140" height="13"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[PRODUCTO / CANTIDAD]]></text></staticText><staticText><reportElement x="140" y="184" width="66" height="13"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[IMPORTE]]></text></staticText></band></title><detail><band height="33"><textField isStretchWithOverflow="true"><reportElement x="0" y="0" width="206" height="15"/><textElement textAlignment="Left"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{descripcion_producto}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="17" width="130" height="14"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0.###",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{cantidad}) + " x $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{precio_unitario})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="132" y="17" width="74" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["$ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{importe})]]></textFieldExpression></textField></band></detail><summary><band height="180"><line><reportElement x="0" y="0" width="206" height="1"/></line><textField isStretchWithOverflow="false"><reportElement x="0" y="7" width="206" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Subtotal: $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{bruto})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="22" width="206" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Descuento: $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{descuento_total})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="39" width="206" height="22"/><textElement textAlignment="Right"><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL: $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{total})]]></textFieldExpression></textField><line><reportElement x="0" y="66" width="206" height="1"/></line><textField isStretchWithOverflow="false"><reportElement x="0" y="72" width="206" height="14"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Pago: " + $F{medio_pago}]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="87" width="206" height="14"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Recibido: $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{recibido})]]></textFieldExpression></textField><textField isStretchWithOverflow="false"><reportElement x="0" y="102" width="206" height="14"/><textElement textAlignment="Left"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Cambio: $ " + new java.text.DecimalFormat("#,##0.00",new java.text.DecimalFormatSymbols(new java.util.Locale("es","AR"))).format($F{cambio})]]></textFieldExpression></textField><line><reportElement x="0" y="121" width="206" height="1"/></line><textField isStretchWithOverflow="false"><reportElement x="0" y="127" width="206" height="15"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{MENSAJE_FINAL}]]></textFieldExpression></textField><staticText><reportElement x="0" y="146" width="206" height="13"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="false"/></textElement><text><![CDATA[Conserve su comprobante]]></text></staticText><staticText><reportElement x="0" y="160" width="206" height="13"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="false"/></textElement><text><![CDATA[Sistema desarrollado por Serena Soft]]></text></staticText></band></summary></jasperReport>