<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ticket_venta" pageWidth="226" pageHeight="700" columnWidth="206" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" whenNoDataType="NoPages">
<parameter name="VENTA_ID" class="java.lang.Long"/>
<queryString><![CDATA[SELECT v.numero_venta, v.fecha, v.total, v.subtotal AS bruto, v.descuento_total, u.nombre_completo AS cajero, COALESCE(c.razon_social, CONCAT_WS(' ',c.nombre,c.apellido),'Consumidor Final') AS cliente, d.descripcion_producto, d.cantidad, d.precio_unitario, d.subtotal AS importe FROM venta v JOIN venta_detalle d ON d.id_venta=v.id_venta LEFT JOIN cliente c ON c.id_cliente=v.id_cliente JOIN usuario u ON u.id_usuario=v.id_usuario WHERE v.id_venta=$P{VENTA_ID} ORDER BY d.id_detalle]]></queryString>
<field name="numero_venta" class="java.lang.Long"/><field name="fecha" class="java.sql.Timestamp"/><field name="total" class="java.math.BigDecimal"/><field name="bruto" class="java.math.BigDecimal"/><field name="descuento_total" class="java.math.BigDecimal"/><field name="cajero" class="java.lang.String"/><field name="cliente" class="java.lang.String"/><field name="descripcion_producto" class="java.lang.String"/><field name="cantidad" class="java.math.BigDecimal"/><field name="precio_unitario" class="java.math.BigDecimal"/><field name="importe" class="java.math.BigDecimal"/>
<title><band height="108">
<staticText><reportElement x="0" y="0" width="206" height="25"/><textElement textAlignment="Center"><font size="17" isBold="true"/></textElement><text><![CDATA[SERENA SOFT]]></text></staticText>
<staticText><reportElement x="0" y="27" width="206" height="15"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[GESTIÓN DE VENTAS · TICKET NO FISCAL]]></text></staticText>
<textField><reportElement x="0" y="49" width="206" height="15"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Venta N° " + String.format("%08d",$F{numero_venta})]]></textFieldExpression></textField>
<textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="64" width="206" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="79" width="206" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Cliente: " + $F{cliente}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="94" width="206" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Cajero: " + $F{cajero}]]></textFieldExpression></textField>
</band></title>
<detail><band height="33">
<textField><reportElement x="0" y="0" width="206" height="15"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{descripcion_producto}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="16" width="115" height="15"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{cantidad}.toPlainString()+" x $"+$F{precio_unitario}.toPlainString()]]></textFieldExpression></textField>
<textField><reportElement x="115" y="16" width="91" height="15"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA["$"+$F{importe}.toPlainString()]]></textFieldExpression></textField>
</band></detail>
<summary><band height="75">
<line><reportElement x="0" y="0" width="206" height="1"/></line>
<textField><reportElement x="0" y="7" width="206" height="16"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA["Descuentos: $"+$F{descuento_total}.toPlainString()]]></textFieldExpression></textField>
<textField><reportElement x="0" y="25" width="206" height="20"/><textElement textAlignment="Right"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL: $"+$F{total}.toPlainString()]]></textFieldExpression></textField>
<staticText><reportElement x="0" y="51" width="206" height="17"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[¡Gracias por su compra!]]></text></staticText>
</band></summary>
</jasperReport>
